{
  "$schema": "https://html-validate.org/schemas/config.json",
  "extends": ["html-validate:recommended", "html-validate:a11y"],
  "rules": {
    "no-inline-style": "error",
    "require-sri": "off",
    "long-title": "off",
    "no-trailing-whitespace": "error",
    "doctype-style": ["error", { "style": "lowercase" }]
  }
}
